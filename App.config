<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="QLQuanPho.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <add name="QLQuanPhoConnectionString" connectionString="Data Source=localhost;Initial Catalog=QLQuanPho;Integrated Security=True;MultipleActiveResultSets=True;Connect Timeout=30;TrustServerCertificate=True;Application Name=QLQuanPhoApp"
            providerName="System.Data.SqlClient" />
        <add name="QLQuanPho.Properties.Settings.QLQuanPhoConnectionString"
            connectionString="Data Source=VANIXJNK;Initial Catalog=QLQuanPho;Integrated Security=True;Connect Timeout=30;Encrypt=True;TrustServerCertificate=True"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="DefaultTaxRate" value="10" />
        <add key="DefaultDiscount" value="0" />
    </appSettings>
    <userSettings>
        <QLQuanPho.Properties.Settings>
            <setting name="RememberAccount" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="RememberedUsername" serializeAs="String">
                <value />
            </setting>
        </QLQuanPho.Properties.Settings>
    </userSettings>
</configuration>