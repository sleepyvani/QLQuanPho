# Mặc định: Git nhận dạng text
* text=auto

# Dùng CRLF cho các file C# và solution trên Windows
*.cs      text eol=crlf
*.xaml    text eol=crlf
*.config  text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf

# Giữ nguyên file nhị phân
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.dll  binary
*.exe  binary
*.zip  binary
*.tar  binary